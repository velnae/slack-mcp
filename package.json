{
  "name": "@velnae/slack-mcp",
  "version": "0.1.4",
  "type": "module",
  "description": "OpenCode plugin and local MCP server for Slack messaging, uploads, and prompt-image capture.",
  "license": "MIT",
  "homepage": "https://github.com/velnae/slack-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velnae/slack-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/velnae/slack-mcp/issues"
  },
  "keywords": [
    "opencode",
    "plugin",
    "mcp",
    "slack"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/opencode/plugin.js",
  "types": "./dist/opencode/plugin.d.ts",
  "bin": {
    "slack-mcp": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/opencode/plugin.d.ts",
      "import": "./dist/opencode/plugin.js",
      "default": "./dist/opencode/plugin.js"
    },
    "./server": {
      "types": "./dist/opencode/plugin.d.ts",
      "import": "./dist/opencode/plugin.js",
      "default": "./dist/opencode/plugin.js"
    },
    "./mcp-server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/opencode/promptImageManifest.d.ts",
      "import": "./dist/opencode/promptImageManifest.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/opencode.example.json",
    "docs/prompt-image-upload.md",
    "docs/aliases.example.json"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/index.js",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/server": "2.0.0-alpha.2",
    "@slack/web-api": "^7.15.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
